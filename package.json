{
  "name": "www.analogstudios.net",
  "version": "2.0.0",
  "private": true,
  "description": "Frontend website for www.analogstudios.net.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnalogStudiosRI/www.analogstudios.net.git"
  },
  "type": "module",
  "keywords": [
    "Analog Studios",
    "Analog",
    "Rhode Island"
  ],
  "homepage": "https://github.com/AnalogStudiosRI/www.analogstudios.net#readme",
  "author": "Owen Buckley <analogstudiosri@gmail.com>",
  "license": "Apache-2.0",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--import @greenwood/cli/register' greenwood develop",
    "build": "NODE_OPTIONS='--import @greenwood/cli/register' greenwood build",
    "serve": "greenwood serve",
    "deploy:preview": "sst deploy --stage preview",
    "deploy:prod": "sst deploy --stage production",
    "lint": "npm run lint:js && npm run lint:ls && npm run lint:css",
    "lint:js": "eslint",
    "lint:ls": "ls-lint \"./src/**/*.js\"",
    "lint:css": "stylelint \"./src/**/*.css\"",
    "check": "tsc",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "wtr",
    "test:tdd": "npm run test --watch",
    "prepare": "husky install"
  },
  "dependencies": {
    "bootstrap": "4.0.0-alpha.4",
    "font-awesome": "4.6.3",
    "web-social-share": "^10.0.0"
  },
  "devDependencies": {
    "@double-great/stylelint-a11y": "^3.0.2",
    "@eslint/js": "^9.18.0",
    "@esm-bundle/chai": "^4.3.4",
    "@greenwood/cli": "^0.34.0",
    "@greenwood/plugin-adapter-aws": "^0.34.0",
    "@greenwood/plugin-css-modules": "^0.34.0",
    "@greenwood/plugin-import-jsx": "^0.34.0",
    "@ls-lint/ls-lint": "^1.10.0",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^6.6.0",
    "@web/test-runner": "^0.18.1",
    "@web/test-runner-junit-reporter": "^0.7.1",
    "eslint": "^9.18.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "globals": "^15.14.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.8.4",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sst": "^4.14.1",
    "stylelint": "^16.10.0",
    "stylelint-config-recommended": "^14.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.21.0"
  }
}
